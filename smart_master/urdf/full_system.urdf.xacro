<?xml version="1.0"?>
<robot name="smart_robot" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Attaching arguments for simulation, so they reach the base -->
  <xacro:arg name="sim" default="false" />
  <xacro:arg name="use_3d_lidar" default="false" />
  <xacro:arg name="god_mode" default="false" />
  <xacro:arg name="use_arm" default="true" />

  <!-- Trackerd UGV platform -->
  <xacro:include filename="$(find ugv_tracked_description)/urdf/ugv_base.urdf.xacro" />

  <!-- Manipulator -->
  <xacro:if value="$(arg use_arm)">
    
    <xacro:include filename="$(find manipulator_description)/urdf/robot_arm.urdf.xacro" />
    
    <joint name="arm_mount_joint" type="fixed">
      <parent link="base_link"/>
      <!-- Attention. "arm_base_link" is the actual name of the root link of arm from manipulator.urdf.xacro -->
      <child link="arm_base_link"/>
      <origin xyz="0.1 -0.03 -0.02" rpy="0 0 1.5708"/> 
    </joint>
  </xacro:if>
</robot>