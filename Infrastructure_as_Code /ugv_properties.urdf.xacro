<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:property name="base_length" value="0.4" />
  <xacro:property name="base_width" value="0.22" />
  <xacro:property name="base_height" value="0.04" />
  <xacro:property name="base_mass" value="10" />
  <xacro:property name="base_mesh_file" value="file://$(find ugv_tracked_description)/meshes/base.STL" />
  <xacro:property name="wheel_radius" value="0.05" />
  <xacro:property name="wheel_width" value="0.04" />
  <xacro:property name="wheel_pos_x" value="0.0" />
  <xacro:property name="wheel_pos_y" value="0.2" />
  <xacro:property name="wheel_pos_z" value="-0.03" />
  <xacro:property name="wheel_mass" value=".5" />
  
  <xacro:property name="front_caster_wheel" value="true" />
  <xacro:property name="rear_caster_wheel" value="true" />
  <xacro:property name="wheel_mesh_file" value="" />
  
  <xacro:property name="laser_pose">
    <origin xyz="-0.12 0.06 0.14" rpy="0 0 0"/>
  </xacro:property>

  <xacro:property name="imu_pose">
    <origin xyz="-0.08 0.045 0.02" rpy="0 0 0"/> 
  </xacro:property>
</robot>