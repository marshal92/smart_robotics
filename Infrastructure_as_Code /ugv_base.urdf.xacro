<?xml version="1.0"?>
<robot name="ugv_tracked" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:arg name="sim" default="false" />
  <xacro:arg name="god_mode" default="false" />
  <xacro:arg name="use_3d_lidar" default="false" />

  <xacro:property name="use_3d" value="$(arg use_3d_lidar)" />

  <xacro:include filename="$(find ugv_tracked_description)/urdf/ugv_properties.urdf.xacro" />
  <xacro:include filename="$(find ugv_tracked_description)/urdf/mech/base.urdf.xacro" />
  <xacro:include filename="$(find ugv_tracked_description)/urdf/mech/wheel.urdf.xacro" />
  <xacro:include filename="$(find ugv_tracked_description)/urdf/mech/caster_wheel.urdf.xacro" />
  <!-- 
  <xacro:include filename="$(find ugv_tracked_description)/urdf/sensors/plugins.urdf.xacro" />
  -->
  <xacro:include filename="$(find ugv_tracked_description)/urdf/sensors/imu.urdf.xacro" />
  <xacro:include filename="$(find ugv_tracked_description)/urdf/sensors/generic_laser.urdf.xacro" />
  <!--
  <xacro:include filename="$(find ugv_tracked_description)/urdf/controllers/diff_drive.urdf.xacro" />
  -->
  <xacro:base length="${base_length}" width="${base_width}" height="${base_height}" mass="${base_mass}" wheel_radius="${wheel_radius}" wheel_pos_z="${wheel_pos_z}" mesh_file="${base_mesh_file}"/>

  <xacro:wheel side="left" radius="${wheel_radius}" width="${wheel_width}" pos_x="${wheel_pos_x}" pos_y="${wheel_pos_y}" pos_z="${wheel_pos_z}" mass="${wheel_mass}" mesh_file="${wheel_mesh_file}"/>
  <xacro:wheel side="right" radius="${wheel_radius}" width="${wheel_width}" pos_x="${wheel_pos_x}" pos_y="${-wheel_pos_y}" pos_z="${wheel_pos_z}" mass="${wheel_mass}" mesh_file="${wheel_mesh_file}"/>

  <xacro:if value="${front_caster_wheel}">
    <xacro:caster_wheel side="front" mass="0.01" base_length="${base_length}" wheel_radius="${wheel_radius}" wheel_pos_z="${wheel_pos_z}" />
  </xacro:if>

  <xacro:if value="${rear_caster_wheel}">
    <xacro:caster_wheel side="rear" mass="0.01" base_length="${base_length}" wheel_radius="${wheel_radius}" wheel_pos_z="${wheel_pos_z}" />
  </xacro:if>

  <xacro:imu/>

  <xacro:unless value="${str(use_3d).strip().lower() == 'true'}">
    <xacro:generic_laser>
      <xacro:insert_block name="laser_pose" />
    </xacro:generic_laser>
  </xacro:unless>

  <xacro:if value="${str(use_3d).strip().lower() == 'true'}">
    <link name="lidar3d_link">
      <visual>
        <geometry><cylinder radius="0.05" length="0.07"/></geometry>
        <material name="black"/>
      </visual>
      <inertial>
        <mass value="0.1"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>

    <joint name="lidar3d_joint" type="fixed">
      <parent link="base_link"/>
      <child link="lidar3d_link"/>
      <xacro:insert_block name="laser_pose" />
    </joint>

   <!--
    <gazebo reference="lidar3d_link">
      <sensor type="gpu_lidar" name="lidar3d_sensor">
        <topic>lidar3d</topic> 
        <gz_frame_id>lidar3d_link</gz_frame_id>
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <visualize>false</visualize> 
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.261799</min_angle> 
              <max_angle>0.261799</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.15</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </gazebo>
-->
  </xacro:if>

 <!--
  <xacro:diff_drive_controller wheel_separation="${wheel_pos_y * 2}" wheel_radius="${wheel_radius}" god_mode="$(arg god_mode)"/>
-->

  </robot>