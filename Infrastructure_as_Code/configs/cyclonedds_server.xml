<?xml version="1.0" encoding="UTF-8" ?>
<CycloneDDS xmlns="https://cdds.io/config" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://cdds.io/config https://raw.githubusercontent.com/eclipse-cyclonedds/cyclonedds/master/etc/cyclonedds.xsd">
    <Domain>
        <General>
            <Interfaces>
                <!-- Laptop Wi-Fi interface adapter -->
                <NetworkInterface name="wlp82s0" priority="default" multicast="default" />
            </Interfaces>
            <!-- Disable multicast to avoid noisy router traffic on laptop -->
            <AllowMulticast>false</AllowMulticast>
        </General>
        <Discovery>
            <Peers>
                <!-- Direct unicast peer address of the Raspberry Pi onboard computer -->
                <Peer address="192.168.31.100"/>
            </Peers>
        </Discovery>
    </Domain>
</CycloneDDS>
