<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="diff_drive_controller" params="wheel_separation wheel_radius god_mode">
    
    <gazebo>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <topic>cmd_vel</topic>
        <child_frame_id>base_footprint</child_frame_id>
        
        <xacro:if value="${god_mode}">
           <odom_topic>odom_trash</odom_topic> <tf_topic>tf_trash</tf_topic>     </xacro:if>
        <xacro:unless value="${god_mode}">
            <tf_topic>tf_trash</tf_topic>
            <odom_topic>odom/unfiltered</odom_topic> </xacro:unless>

        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>${wheel_separation * 1.15}</wheel_separation>
        <wheel_radius>${wheel_radius}</wheel_radius>
        <odom_publish_frequency>50</odom_publish_frequency>
        
        <max_linear_acceleration>2</max_linear_acceleration>
        <min_linear_acceleration>-2</min_linear_acceleration>
        <max_angular_acceleration>2</max_angular_acceleration>
        <min_angular_acceleration>-2</min_angular_acceleration>
      </plugin>

      <xacro:if value="${god_mode}">
        <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
          <odom_frame>odom</odom_frame>
          <robot_base_frame>base_footprint</robot_base_frame>
          
          <odom_topic>odom/unfiltered</odom_topic> <tf_topic>/tf</tf_topic>                  <odom_publish_frequency>50</odom_publish_frequency>
          <xyz_offset>0 0 0</xyz_offset>
          <rpy_offset>0 0 0</rpy_offset>
          <gaussian_noise>0.0</gaussian_noise>
        </plugin>
      </xacro:if>

      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        <topic>joint_states</topic>
        <update_rate>50</update_rate>
        <joint_name>left_wheel_joint</joint_name>
        <joint_name>right_wheel_joint</joint_name>
      </plugin>    
    </gazebo>
  </xacro:macro>
</robot>